# ========================================================
# DISASTER MANAGEMENT & ALERT SYSTEM - ENVIRONMENT CONFIG
# Copy this file to .env and configure for your deployment
# NEVER commit the actual .env file with secrets to Git!
# ========================================================

# Server Port
PORT=8080

# Active Spring Profile (e.g., prod, dev, test)
SPRING_PROFILES_ACTIVE=prod

# Database Connection (MySQL)
DB_URL=jdbc:mysql://localhost:3306/disaster_management?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
DB_USERNAME=root
DB_PASSWORD=your_secure_database_password_here

# JPA / Hibernate DDL behavior (update for dev, validate for prod)
JPA_DDL_AUTO=update

# JWT Authentication Secret (Must be at least 256-bit / 32 characters)
JWT_SECRET=replace_this_with_a_secure_random_64_character_string_for_production_use_2026
JWT_EXPIRATION_MS=86400000

# Admin Step-Up Security PIN Duration (Minutes)
ADMIN_STEP_UP_MINUTES=15

# NDMA SACHET Live Feed Ingestion
NDMA_RSS_URL=https://sachet.ndma.gov.in/cap_public_website/rss/rss_india.xml
NDMA_SYNC_ENABLED=true
NDMA_SYNC_INTERVAL_MS=300000
NDMA_SYNC_INITIAL_DELAY_MS=5000
NDMA_SYNC_MAX_ITEMS=30

# IMD & Weather API Credentials (Optional: Leave blank for WMO observation fallback)
IMD_API_URL=https://api.imd.gov.in/api
IMD_API_KEY=
IMD_JWT_TOKEN=
WEATHER_FALLBACK_URL=https://api.open-meteo.com/v1/forecast

